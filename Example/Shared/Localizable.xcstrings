  "strings" : {
    "BiometricAuthentication" : {
      "comment" : "The title of the login screen.",
      "isCommentAutoGenerated" : true
    },
    "biometry.not.available" : {
      "comment" : "Shown when the device cannot perform biometric authentication at all.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometric authentication is not available for this device."
          }
        }
      }
    },
    "companion.not.available" : {
      "comment" : "Shown when no paired companion device (e.g. Apple Watch) is nearby to authenticate.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No paired companion device is nearby. Please bring your Apple Watch closer and try again."
          }
        }
      }
    },
    "faceid.authentication.reason" : {
      "comment" : "Reason shown in the Face ID system prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm your face to authenticate."
          }
        }
      }
    },
    "faceid.failed.reason" : {
      "comment" : "Shown after a Face ID authentication attempt fails.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID does not recognize your face. Please try again with your enrolled face."
          }
        }
      }
    },
    "faceid.not.enrolled" : {
      "comment" : "Shown when the device supports Face ID but no face is enrolled.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no face enrolled in the device. Please go to Device Settings -> Face ID & Passcode and enroll your face."
          }
        }
      }
    },
    "faceid.passcode.authentication.reason" : {
      "comment" : "Reason shown when Face ID is locked out and the user must enter the device passcode.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is locked now, because of too many failed attempts. Enter passcode to unlock Face ID."
          }
        }
      }
    },
    "faceid.set.passcode" : {
      "comment" : "Shown when the user has not configured a device passcode (required for Face ID).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please set device passcode to use Face ID for authentication."
          }
        }
      }
    },
